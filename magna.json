{
    "name": "magna-cms/forms",
    "displayName": "Magna Forms",
    "description": "Forms for the site: build a form in the admin, drop it on any page with the form block, collect submissions with spam protection and email notification.",
    "version": "0.1.0",
    "author": "Magna Team",
    "license": "proprietary",
    "compat": {
        "magna": ">=1.4.8 <2.0",
        "php": "^8.3"
    },
    "entry": "Magna\\Forms\\FormsPlugin",
    "provides": {
        "settingsPages": true,
        "adminNavigation": true
    },
    "permissions": [
        "forms.manage",
        "forms.submissions"
    ],
    "uninstall": {
        "tables": ["forms_forms", "forms_submissions"]
    }
}
